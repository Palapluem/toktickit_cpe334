// TokTickIT data model. Authority: docs/lab-03/specification.md §7,
// extending docs/lab-02/specification.md §7.
// UUID identifiers (lab-02 §11.1). Timestamps UTC.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Lab 2 declared seven values of which only NEW was reachable. Lab 3 renames
/// two and adds REOPENED, making all eight reachable through §5.1.
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

/// Exactly one per user (BR-11). Only these three are assignable (BR-34).
enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

/// Renamed from Lab 2's RequesterUser, keeping every identifier (BR-40, §11.4).
model User {
  id           String @id @default(uuid()) @db.Uuid
  displayName  String
  email        String @unique
  /// Salted slow hash only. Never plaintext, never logged, never returned (BR-04).
  passwordHash String

  role               Role    @default(REQUESTER)
  mustChangePassword Boolean @default(true)
  isActive           Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tickets             Ticket[]        @relation("TicketRequester")
  ownedTickets        Ticket[]        @relation("TicketOwner")
  uploadedAttachments Attachment[]    @relation("AttachmentUploader")
  removedAttachments  Attachment[]    @relation("AttachmentRemover")
  sessions            Session[]
  publicComments      PublicComment[]
  internalNotes       InternalNote[]

  @@index([role, isActive]) // admin list filter and the BR-36 count
}

/// id is the opaque token itself: 32 random bytes, base64url (api-spec.md §1).
model Session {
  id        String   @id
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // invalidating a user's sessions (BR-07, BR-39)
  @@index([expiresAt]) // expiry sweeps
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tickets Ticket[]
}

model RelatedSystem {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tickets Ticket[]
}

model Ticket {
  id       String @id @default(uuid()) @db.Uuid
  ticketNo String @unique

  requesterId     String @db.Uuid
  categoryId      String @db.Uuid
  relatedSystemId String @db.Uuid

  summary     String
  description String

  requestedPriority Priority
  itPriority        Priority
  status            TicketStatus @default(NEW)

  /// Zero or one owner, who must be an active IT Staff or Administrator (BR-16).
  ownerId String? @db.Uuid

  /// The Requester's "appears resolved" signal. A timestamp, not a status (§11.7).
  requesterResolvedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  requester     User          @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  owner         User?         @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem RelatedSystem @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)

  attachments    Attachment[]
  publicComments PublicComment[]
  internalNotes  InternalNote[]

  @@index([requesterId, createdAt(sort: Desc)]) // default list query (lab-02 BR-37)
  @@index([requesterId, status]) // lab-02 FR-18 filters
  @@index([requesterId, categoryId])
  @@index([status, itPriority, createdAt(sort: Desc)]) // staff queue default order
  @@index([ownerId]) // assigned to me
}

model Attachment {
  id       String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid

  originalFilename String
  /// Generated, never derived from user input (lab-02 BR-30).
  storedFilename   String @unique
  mimeType         String
  sizeBytes        Int

  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  /// Soft removal (lab-02 BR-31). removedAt is the only source of truth.
  removedAt     DateTime? @db.Timestamptz(3)
  removedReason String?
  removedById   String?   @db.Uuid

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  // Two references to one model, so both are named (§7).
  uploadedBy User   @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  removedBy  User?  @relation("AttachmentRemover", fields: [removedById], references: [id], onDelete: Restrict)

  @@index([ticketId, removedAt]) // active-attachment count (lab-02 BR-28)
}

/// Append-only. Visible to the owning Requester, IT Staff, and Administrator (BR-26).
model PublicComment {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt]) // thread retrieval
}

/// Append-only. Visible only to IT Staff and Administrator (BR-27).
model InternalNote {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt]) // thread retrieval
}

/// One row per Bangkok calendar year (lab-02 §11.13), locked inside the
/// creation transaction.
model TicketNumberSequence {
  year      Int      @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
