// TokTickIT data model — Lab 2 sprint scope.
//
// Authority: `docs/lab-02/specification.md` §7, drawn as a class diagram in
// `docs/lab-02/diagrams.md` §1. Where this file and the specification disagree,
// the specification wins and this file is corrected (AGENTS.md §4).
//
// Identifiers are UUID throughout (§11.1). Timestamps are stored in UTC; the
// Bangkok calendar governs only the year label inside a Ticket Number (§11.13).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  PENDING_REQUESTER
  RESOLVED
  CLOSED
  CANCELLED
}

/// Temporary Lab 2 stand-in for the authenticated user (BR-03, BR-42).
/// Lab 3 replaces this with a User model carrying roles; the requester
/// identifier then comes from the session rather than from a request header.
model RequesterUser {
  id          String   @id @default(uuid()) @db.Uuid
  displayName String
  email       String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  tickets             Ticket[]
  uploadedAttachments Attachment[] @relation("AttachmentUploader")
  removedAttachments  Attachment[] @relation("AttachmentRemover")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tickets Ticket[]
}

model RelatedSystem {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tickets Ticket[]
}

model Ticket {
  id       String @id @default(uuid()) @db.Uuid
  ticketNo String @unique

  requesterId     String @db.Uuid
  categoryId      String @db.Uuid
  relatedSystemId String @db.Uuid

  summary     String
  description String

  requestedPriority Priority
  itPriority        Priority
  status            TicketStatus @default(NEW)

  /// Stays null for the whole of Lab 2 (BR-07). Modelled now so that Lab 3 adds
  /// a foreign key rather than a column.
  ownerId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  requester     RequesterUser @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem RelatedSystem @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)
  attachments   Attachment[]

  // Every list query is requester-scoped and default-sorted newest first (BR-37).
  @@index([requesterId, createdAt(sort: Desc)])
  // The filters exposed by FR-18.
  @@index([requesterId, status])
  @@index([requesterId, categoryId])
}

model Attachment {
  id       String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid

  originalFilename String
  /// Generated, never derived from user input (BR-30).
  storedFilename   String @unique
  mimeType         String
  sizeBytes        Int

  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  /// Soft removal (BR-31). `removedAt` is the single source of truth for whether
  /// an attachment is active; a separate boolean could disagree with it.
  removedAt     DateTime? @db.Timestamptz(3)
  removedReason String?
  removedById   String?   @db.Uuid

  ticket     Ticket         @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  // Two references to the same model, so both relations are named (§7).
  uploadedBy RequesterUser  @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  removedBy  RequesterUser? @relation("AttachmentRemover", fields: [removedById], references: [id], onDelete: Restrict)

  // The active-attachment count in BR-28.
  @@index([ticketId, removedAt])
}

/// One row per calendar year, updated inside the ticket-creation transaction.
/// Exists instead of MAX(ticketNo)+1 or a Postgres sequence: MAX is not safe
/// under concurrent creation without locking the table, and a plain sequence
/// cannot restart per year without an out-of-band job (§7). The year is the
/// Asia/Bangkok year, matching the label it feeds (§11.13).
model TicketNumberSequence {
  year      Int      @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
