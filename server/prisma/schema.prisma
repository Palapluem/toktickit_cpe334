// TokTickIT data model. Authority: docs/lab-04/specification.md §7,
// extending docs/lab-03/specification.md §7 and docs/lab-02/specification.md §7.
// UUID identifiers (lab-02 §11.1). Timestamps UTC.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Lab 2 declared seven values of which only NEW was reachable. Lab 3 renames
/// two and adds REOPENED, making all eight reachable through §5.1.
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

/// Lifecycle of one Action Taken (lab-04 BR-09). COMPLETED and CANCELLED are terminal (BR-10).
enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// What a TicketEvent records (lab-04 BR-26).
enum TicketEventType {
  STATUS_CHANGED
  OWNER_CHANGED
  IT_PRIORITY_CHANGED
  ACTION_CREATED
  ACTION_UPDATED
  ACTION_ASSIGNED
  ACTION_STARTED
  ACTION_COMPLETED
  ACTION_CANCELLED
}

/// Exactly one per user (BR-11). Only these three are assignable (BR-34).
enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

/// Renamed from Lab 2's RequesterUser, keeping every identifier (BR-40, §11.4).
model User {
  id           String @id @default(uuid()) @db.Uuid
  displayName  String
  email        String @unique
  /// Salted slow hash only. Never plaintext, never logged, never returned (BR-04).
  passwordHash String

  role               Role    @default(REQUESTER)
  mustChangePassword Boolean @default(true)
  isActive           Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tickets             Ticket[]        @relation("TicketRequester")
  ownedTickets        Ticket[]        @relation("TicketOwner")
  uploadedAttachments Attachment[]    @relation("AttachmentUploader")
  removedAttachments  Attachment[]    @relation("AttachmentRemover")
  sessions            Session[]
  publicComments      PublicComment[]
  internalNotes       InternalNote[]
  assignedActions     ActionTaken[]   @relation("ActionAssignee")
  performedActions    ActionTaken[]   @relation("ActionPerformer")
  completedActions    ActionTaken[]   @relation("ActionCompleter")
  cancelledActions    ActionTaken[]   @relation("ActionCanceller")
  ticketEvents        TicketEvent[]

  @@index([role, isActive]) // admin list filter and the BR-36 count
}

/// id is the opaque token itself: 32 random bytes, base64url (api-spec.md §1).
model Session {
  id        String   @id
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // invalidating a user's sessions (BR-07, BR-39)
  @@index([expiresAt]) // expiry sweeps
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tickets Ticket[]
}

model RelatedSystem {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tickets Ticket[]
}

model Ticket {
  id       String @id @default(uuid()) @db.Uuid
  ticketNo String @unique

  requesterId     String @db.Uuid
  categoryId      String @db.Uuid
  relatedSystemId String @db.Uuid

  summary     String
  description String

  requestedPriority Priority
  itPriority        Priority
  status            TicketStatus @default(NEW)

  /// Zero or one owner, who must be an active IT Staff or Administrator (BR-16).
  ownerId String? @db.Uuid

  /// The Requester's "appears resolved" signal. A timestamp, not a status (§11.7).
  requesterResolvedAt DateTime? @db.Timestamptz(3)

  /// Optimistic-concurrency counter for status changes (lab-04 BR-31).
  version Int @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  requester     User          @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  owner         User?         @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem RelatedSystem @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)

  attachments    Attachment[]
  publicComments PublicComment[]
  internalNotes  InternalNote[]
  actions        ActionTaken[]
  events         TicketEvent[]

  @@index([requesterId, createdAt(sort: Desc)]) // default list query (lab-02 BR-37)
  @@index([requesterId, status]) // lab-02 FR-18 filters
  @@index([requesterId, categoryId])
  @@index([status, itPriority, createdAt(sort: Desc)]) // staff queue default order
  @@index([ownerId]) // assigned to me
  @@index([updatedAt(sort: Desc), id]) // "Recently updated" lists (lab-04 MET-S07, MET-R05)
}

model Attachment {
  id       String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid

  originalFilename String
  /// Generated, never derived from user input (lab-02 BR-30).
  storedFilename   String @unique
  mimeType         String
  sizeBytes        Int

  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  /// Soft removal (lab-02 BR-31). removedAt is the only source of truth.
  removedAt     DateTime? @db.Timestamptz(3)
  removedReason String?
  removedById   String?   @db.Uuid

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  // Two references to one model, so both are named (§7).
  uploadedBy User   @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  removedBy  User?  @relation("AttachmentRemover", fields: [removedById], references: [id], onDelete: Restrict)

  @@index([ticketId, removedAt]) // active-attachment count (lab-02 BR-28)
}

/// Append-only. Visible to the owning Requester, IT Staff, and Administrator (BR-26).
model PublicComment {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt]) // thread retrieval
}

/// Append-only. Visible only to IT Staff and Administrator (BR-27).
model InternalNote {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt]) // thread retrieval
}

/// One line of service work on a Ticket (lab-04 §7). Assignee, performer and the Ticket Owner are
/// independent people (BR-02). Server-owned fields are never taken from the client (BR-05).
model ActionTaken {
  id       String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid

  description      String
  result           String?
  followUpRequired Boolean @default(false)
  followUpNote     String?
  attachmentNotes  String?

  status ActionStatus @default(PLANNED)

  assigneeId    String  @db.Uuid
  performedById String  @db.Uuid
  completedById String? @db.Uuid
  cancelledById String? @db.Uuid

  completedAt        DateTime? @db.Timestamptz(3)
  cancelledAt        DateTime? @db.Timestamptz(3)
  cancellationReason String?

  /// Client-generated per form submission, so a retried create returns the original (BR-34).
  requestId String @db.Uuid
  version   Int    @default(1)

  /// The Action Date/Time: the server's time of creation (lab-04 §11.3).
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  assignee    User   @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  performedBy User   @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  completedBy User?  @relation("ActionCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  cancelledBy User?  @relation("ActionCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)

  events TicketEvent[]

  @@unique([ticketId, requestId]) // idempotent creation (BR-34)
  @@index([ticketId, createdAt, id]) // the ordered Action list (BR-29)
  @@index([assigneeId, status]) // "My open Actions" (MET-S06)
}

/// Append-only history of material changes (lab-04 BR-26, BR-27). A database trigger rejects UPDATE
/// and DELETE; the payload holds identifiers, statuses and field names only (BR-30).
model TicketEvent {
  id        String          @id @default(uuid()) @db.Uuid
  ticketId  String          @db.Uuid
  actorId   String          @db.Uuid
  type      TicketEventType
  actionId  String?         @db.Uuid
  payload   Json
  createdAt DateTime        @default(now()) @db.Timestamptz(3)

  ticket Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor  User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action ActionTaken? @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id]) // ordered history (BR-29)
}

/// One row per Bangkok calendar year (lab-02 §11.13), locked inside the
/// creation transaction.
model TicketNumberSequence {
  year      Int      @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
