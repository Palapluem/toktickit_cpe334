# Development database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/toktickit_dev?schema=public"
PORT=3001

# Automated tests run against a SEPARATE database (`docs/lab-02/specification.md`
# §11.16). Copy this file to `.env.test` and point DATABASE_URL at a database
# whose name ends in `_test` — `npm test` refuses to run otherwise, because
# preparing the test database rewrites whatever DATABASE_URL points at.
#
#   createdb toktickit_test
#   cp .env.example .env.test      # then edit DATABASE_URL to toktickit_test
#   npm test                       # migrates, seeds, and runs the suite
#
# Neither .env nor .env.test is tracked. Only this example is.
