# TokTickIT Lab 1 — required environment variables
#
# This file documents every variable used across the project. Copy each
# relevant section into the matching package before running anything:
#   cp .env.example server/.env   (edit DATABASE_URL and PORT)
#   cp .env.example client/.env   (edit VITE_API_BASE_URL)
# Never commit the real server/.env or client/.env files — only .env.example.

# --- server/.env ---
# Local PostgreSQL connection string. Use a disposable local Lab database,
# never a shared/production database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/toktickit_dev?schema=public"
PORT=3001
# Local-only seed/test password. Set it in ignored .env and .env.test.
LAB3_SEED_PASSWORD=

# Session cookie (Lab 3). Set to true only where the transport is HTTPS —
# a Secure cookie is never sent over plain HTTP, so a local server that sets it
# appears to lose every session (SEC-013).
SESSION_COOKIE_SECURE=false
# Origin allowed to send the session cookie. Leave unset to reflect the
# request's own origin, which is what local development needs.
CLIENT_ORIGIN=http://localhost:5173

# --- client/.env ---
# Base URL the frontend uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:3001
